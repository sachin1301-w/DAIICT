# Copy to backend/.env if you want to override defaults (config.py reads
# these via os.getenv -- nothing here is required, they all have sane
# defaults for local development).

DATABASE_URL=sqlite:///rec_fraud.db

SIMULATION_INTERVAL_SECONDS=5
FRAUD_PROBABILITY=0.15
SIMULATION_AUTOSTART=true

RULE_SCORE_WEIGHT=0.30
ML_SCORE_WEIGHT=0.30
GRAPH_SCORE_WEIGHT=0.40
DECISION_RULE_SCORE_FRAUD_THRESHOLD=80
DECISION_GRAPH_SCORE_FRAUD_THRESHOLD=80
DECISION_ML_SCORE_SUSPICIOUS_THRESHOLD=80

WEB3_PROVIDER_URI=http://127.0.0.1:8545
# Hardhat's well-known local dev account #0 -- never use this key anywhere but a local Hardhat node
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_HOST=0.0.0.0
API_PORT=8000

# frontend/.env (Vite reads this one, not backend/.env)
# VITE_API_BASE=http://localhost:8000
